<style>
:root{--green:#08783e;--deep:#064b2b;--gold:#e3b83f;--ink:#18251e;--muted:#637168;--paper:#f6f8f5}
*{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);line-height:1.6} a{color:inherit;text-decoration:none}
header{position:sticky;top:0;background:#fff;box-shadow:0 2px 16px #00000012;z-index:10}
.nav{max-width:1160px;margin:auto;padding:12px 22px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{display:flex;align-items:center;gap:12px;font-weight:800;color:var(--deep)} .logo img{width:88px;height:58px;object-fit:contain} .logo span{font-size:14px;line-height:1.2;max-width:190px}
nav{display:flex;gap:20px;flex-wrap:wrap;font-size:14px;font-weight:700} nav a:hover{color:var(--green)}
.hero{background:linear-gradient(90deg,#042f20e8,#064b2bb8),url('https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2000&q=85') center/cover;color:white;padding:105px 22px}
.hero-inner{max-width:1160px;margin:auto} .eyebrow{color:#f2d77b;text-transform:uppercase;letter-spacing:2px;font-weight:800;font-size:13px}
h1{font-size:clamp(36px,6vw,66px);line-height:1.08;max-width:850px;margin:16px 0} .hero p{font-size:19px;max-width:700px;color:#f0f4f1}
.btn{display:inline-block;background:var(--gold);color:#173b27;padding:13px 22px;border-radius:5px;font-weight:800;margin:12px 10px 0 0} .btn.outline{background:transparent;color:#fff;border:1px solid #ffffffa8}
section{padding:76px 22px} .wrap{max-width:1160px;margin:auto} .section-tag{color:var(--green);font-size:12px;font-weight:800;letter-spacing:2px;text-transform:uppercase}
h2{font-size:clamp(28px,4vw,42px);line-height:1.15;margin:8px 0 18px;color:var(--deep)} .intro{max-width:760px;color:var(--muted);font-size:17px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:32px} .card{background:#fff;border:1px solid #e5ebe6;border-radius:12px;padding:25px;box-shadow:0 8px 24px #12331a0a} .card .symbol{font-size:30px} .card h3{color:var(--deep);margin:10px 0 8px}
.soft{background:var(--paper)} .band{background:var(--deep);color:white} .band h2{color:white} .band p{color:#e4eee7}
.project{border-left:4px solid var(--gold);padding:5px 0 5px 20px;margin-top:26px}
