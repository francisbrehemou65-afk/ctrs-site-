small{color:#b9cbbf} .mobile-note{font-size:12px;color:var(--muted);margin-top:20px}
@media(max-width:800px){.nav{align-items:flex-start;flex-direction:column}nav{gap:12px}.hero{padding:75px 22px}.cards{grid-template-columns:1fr}.contact-grid{grid-template-columns:1fr}}
</style>
